<!-- PowerToys の設定アプリと同じ形: 左にページの一覧、右にそのページ（Pages/ の UserControl） -->
<Window x:Class="DisplayRescue.Settings.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DisplayRescueの設定"
        Icon="Assets/display-rescue.ico"
        Width="960" Height="680" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Closing="OnClosing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左: ページの一覧と、下にバージョン -->
        <DockPanel Grid.Column="0">
            <!-- バージョン。Interop の DLL を読めたかどうかもここで分かる -->
            <TextBlock x:Name="VersionText" DockPanel.Dock="Bottom" Margin="16,8,16,12" Style="{StaticResource Caption}" />
            <!-- Tag は MainWindow.xaml.cs の _pages の鍵 -->
            <ListBox x:Name="Pages" Margin="8,8,8,0" Background="Transparent" BorderThickness="0" SelectionChanged="OnPageChanged">
                <ListBoxItem Content="全般" Tag="General" Padding="12,8" />
                <ListBoxItem Content="キーの割り当て" Tag="Hotkeys" Padding="12,8" />
                <ListBoxItem Content="マスコット" Tag="Mascot" Padding="12,8" />
            </ListBox>
        </DockPanel>

        <!-- 右: ページ。一覧とは背景を変え、左上だけ角を丸めて一段上に重ねたように見せる（WinUI の NavigationView の形）。
             スクロールと下の帯はページ側が持つ -->
        <Border Grid.Column="1"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
            <ContentControl x:Name="PageHost" />
        </Border>
    </Grid>
</Window>
