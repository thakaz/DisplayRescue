<!-- アプリ全体。ThemeMode="System" で Windows の明暗の設定に合わせた Fluent テーマ（.NET 9 から） -->
<Application x:Class="DisplayRescue.Settings.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="System"
             ShutdownMode="OnMainWindowClose">
    <!-- ページで共通に使う見た目。色は Fluent テーマのブラシ（明暗で切り替わる）を DynamicResource で引く -->
    <Application.Resources>
        <!-- ページの見出し -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!-- カードの束ねの見出し（「モデル」「モーション」など） -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,24,0,8" />
        </Style>

        <!-- 説明の文。薄い文字色 -->
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <!-- 設定 1 つ分の枠。背景を一段明るく（暗く）して、枠線と角の丸みで区切る -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!-- カードの中の区切り線 -->
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="-16,12" />
            <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        </Style>

        <!-- ページの下に固定する帯（保存ボタンなど） -->
        <Style x:Key="Footer" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="32,12" />
        </Style>
    </Application.Resources>
</Application>
