<!-- キーの割り当て。行は操作ごと（拡張・複製・メインのみ・サブのみ）にコードで作る（HotkeysPage.xaml.cs の BuildRows） -->
<UserControl x:Class="DisplayRescue.Settings.Pages.HotkeysPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="キーの割り当て" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Margin="0,8,0,0" Opacity="0.8" TextWrapping="Wrap"
                   Text="入力欄を選んで、割り当てたいキーを押してください。Backspaceで割り当てなしにします。ロック画面・ログイン画面でも効きます。" />

        <Grid x:Name="Rows" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MaxWidth="320" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
        </Grid>

        <TextBlock x:Name="MessageText" Margin="0,16,0,0" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="保存" MinWidth="100" Padding="16,6" Click="OnSave" />
            <Button Content="元に戻す" MinWidth="100" Padding="16,6" Margin="8,0,0,0" Click="OnRevert" ToolTip="保存してある割り当てに戻します" />
            <Button Content="既定に戻す" MinWidth="100" Padding="16,6" Margin="8,0,0,0" Click="OnResetDefaults" ToolTip="Ctrl+Alt+F8〜F11に戻します(保存は「保存」で)" />
        </StackPanel>
    </StackPanel>
</UserControl>
