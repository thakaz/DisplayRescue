<!-- 全般: サービスの状態・バージョン・インストール -->
<UserControl x:Class="DisplayRescue.Settings.Pages.GeneralPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24" MaxWidth="1000">
            <TextBlock Text="全般" Style="{StaticResource PageTitle}" />

            <TextBlock Text="サービス" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
                            <TextBlock x:Name="VersionText" Margin="0,4,0,0" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="InstallButton" MinWidth="120" Padding="16,6" Click="OnInstall" />
                            <Button x:Name="UninstallButton" Content="アンインストール" MinWidth="120" Padding="16,6" Margin="8,0,0,0" Click="OnUninstall" />
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <TextBlock Style="{StaticResource Caption}"
                               Text="インストールすると、サービス(DisplayRescueService.exe)とマスコット(DisplayRescueMascot.exe)をProgram Filesに置き、ログイン画面でもキーで切り替えられるようにします。この設定アプリは、展開したフォルダから開いて使います。" />

                    <!-- インストールの途中経過（CLI の出力） -->
                    <TextBox x:Name="OutputBox" Margin="0,12,0,0" Height="180" IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas, BIZ UDGothic" Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
