// 設定ダイアログのレイアウトと exe のバージョン情報
#pragma code_page(65001)

#include <windows.h>
#include "resource.h"
#include "../Version.h"

IDI_DISPLAY_RESCUE ICON "assets/display-rescue.ico"
IDI_EXTEND ICON "assets/extend.ico"
IDI_CLONE ICON "assets/clone.ico"
IDI_INTERNAL ICON "assets/internal.ico"
IDI_EXTERNAL ICON "assets/external.ico"

// 座標と大きさは「ダイアログ単位」（フォントの大きさに比例するので、DPI が変わっても崩れない）
IDD_SETTINGS DIALOGEX 0, 0, 258, 234
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "DisplayRescueの設定"
FONT 9, "Yu Gothic UI", 400, 0, 0x80
BEGIN
    GROUPBOX        "キーの割り当て", IDC_STATIC, 7, 7, 244, 108

    CONTROL         "", IDC_MODE_EXTEND, "Static", SS_OWNERDRAW, 14, 19, 16, 16
    LTEXT           "拡張", IDC_STATIC, 34, 23, 52, 8
    CONTROL         "", IDC_HOTKEY_EXTEND, "msctls_hotkey32", WS_BORDER | WS_TABSTOP, 88, 21, 110, 13
    PUSHBUTTON      "外す", IDC_CLEAR_EXTEND, 204, 20, 38, 14

    CONTROL         "", IDC_MODE_CLONE, "Static", SS_OWNERDRAW, 14, 37, 16, 16
    LTEXT           "複製", IDC_STATIC, 34, 41, 52, 8
    CONTROL         "", IDC_HOTKEY_CLONE, "msctls_hotkey32", WS_BORDER | WS_TABSTOP, 88, 39, 110, 13
    PUSHBUTTON      "外す", IDC_CLEAR_CLONE, 204, 38, 38, 14

    CONTROL         "", IDC_MODE_INTERNAL, "Static", SS_OWNERDRAW, 14, 55, 16, 16
    LTEXT           "メインのみ", IDC_STATIC, 34, 59, 52, 8
    CONTROL         "", IDC_HOTKEY_INTERNAL, "msctls_hotkey32", WS_BORDER | WS_TABSTOP, 88, 57, 110, 13
    PUSHBUTTON      "外す", IDC_CLEAR_INTERNAL, 204, 56, 38, 14

    CONTROL         "", IDC_MODE_EXTERNAL, "Static", SS_OWNERDRAW, 14, 73, 16, 16
    LTEXT           "サブのみ", IDC_STATIC, 34, 77, 52, 8
    CONTROL         "", IDC_HOTKEY_EXTERNAL, "msctls_hotkey32", WS_BORDER | WS_TABSTOP, 88, 75, 110, 13
    PUSHBUTTON      "外す", IDC_CLEAR_EXTERNAL, 204, 74, 38, 14

    PUSHBUTTON      "既定に戻す", IDC_RESET_DEFAULTS, 182, 93, 60, 14

    GROUPBOX        "サービス", IDC_STATIC, 7, 119, 244, 58
    LTEXT           "", IDC_SERVICE_STATUS, 16, 131, 226, 8
    LTEXT           "", IDC_VERSION, 16, 142, 226, 16
    PUSHBUTTON      "インストール", IDC_INSTALL, 16, 158, 70, 14
    PUSHBUTTON      "アンインストール", IDC_UNINSTALL, 90, 158, 70, 14

    LTEXT           "", IDC_MESSAGE, 16, 185, 226, 24

    DEFPUSHBUTTON   "OK", IDOK, 91, 213, 50, 14
    PUSHBUTTON      "キャンセル", IDCANCEL, 146, 213, 50, 14
    PUSHBUTTON      "適用", IDC_APPLY, 201, 213, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    DR_VERSION_MAJOR, DR_VERSION_MINOR, DR_VERSION_PATCH, 0
 PRODUCTVERSION DR_VERSION_MAJOR, DR_VERSION_MINOR, DR_VERSION_PATCH, 0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041104B0"
        BEGIN
            VALUE "CompanyName",      "thakaz"
            VALUE "FileDescription",  "DisplayRescue"
            VALUE "FileVersion",      DR_VERSION_STRING
            VALUE "InternalName",     "DisplayRescue"
            VALUE "LegalCopyright",   "Copyright (c) 2026 thakaz"
            VALUE "OriginalFilename", "DisplayRescue.exe"
            VALUE "ProductName",      "DisplayRescue"
            VALUE "ProductVersion",   DR_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0411, 1200
    END
END
